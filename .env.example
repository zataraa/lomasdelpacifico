# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for the live site.
#
# The contact form delivers through the project's own IONOS mailbox over
# SMTP — no third-party mail service. Leads arrive at the address set in
# config/site.ts → contact.email (info@lomasdelpacifico.mx).
#
# Without SMTP_USER and SMTP_PASSWORD the form returns an error and tells
# visitors to write on WhatsApp; it never silently drops a lead.

# The full mailbox address, used both to authenticate and as the sender.
SMTP_USER=info@lomasdelpacifico.mx

# That mailbox's password, exactly as used to sign in to IONOS webmail.
# Never commit this — set it in Vercel's dashboard.
SMTP_PASSWORD=

# Optional; these defaults are IONOS Mexico and rarely need changing.
# Port 587 uses STARTTLS, 465 uses implicit TLS.
# SMTP_HOST=smtp.ionos.mx
# SMTP_PORT=587
